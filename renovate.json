{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "ansible-galaxy",
    "custom.regex",
    "docker-compose",
    "flux",
    "github-actions",
    "kubernetes",
    "mise",
    "terraform"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update a version that has a renovate comment in Ansible variables or a cluster config",
      "managerFilePatterns": [
        "/^ansible/.+\\.ya?ml$/",
        "/^[a-z]+-cluster/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n[A-Za-z0-9_]+: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update a version that has a renovate comment in OpenTofu locals",
      "managerFilePatterns": [
        "/^tofu/.+\\.tf$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n\\s*[A-Za-z0-9_]+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Pangolin Enterprise Edition tags have the form ee-<version>",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/fosrl/pangolin",
        "fosrl/pangolin"
      ],
      "versioning": "regex:^ee-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Wait 3 days before a bump of code that runs in the pipelines with the secrets. Most bad releases are found and pulled in that time.",
      "matchManagers": [
        "ansible-galaxy",
        "github-actions",
        "mise",
        "terraform"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Wait for the precompiled build of a new Python. mise does not compile Python.",
      "matchDepNames": [
        "python"
      ],
      "matchManagers": [
        "mise"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Keep talosctl at the Talos version of the nodes",
      "matchDepNames": [
        "siderolabs/talos",
        "talosctl"
      ],
      "groupName": "talos"
    }
  ],
  "flux": {
    "managerFilePatterns": [
      "/^[a-z]+-cluster/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^[a-z]+-cluster/.+\\.ya?ml$/"
    ]
  }
}
