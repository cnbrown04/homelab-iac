// Ansible installs this policy. Headscale denies each connection that no
// grant allows.
{
  // The tags have no owner. Only a pre-auth key from the Headscale CLI can
  // put a tag on a node.
  "tagOwners": {
    "tag:github-actions": [],
    "tag:proxmox": [],
    "tag:nas": [],
    "tag:dev": [],
  },

  // Headscale approves these routes when a node with the tag advertises them.
  // The typhon VLAN goes through gaia. The grant to autogroup:member covers
  // it. The grant to tag:github-actions does not.
  "autoApprovers": {
    "routes": {
      "10.0.20.0/24": ["tag:proxmox"],
    },
  },

  "grants": [
    // The devices of the owner get to every node on every port.
    {
      "src": ["autogroup:member"],
      "dst": ["*"],
      "ip": ["*"],
    },

    // A pipeline job gets to the Proxmox API port only. See AGENTS.md.
    {
      "src": ["tag:github-actions"],
      "dst": ["tag:proxmox"],
      "ip": ["tcp:8006"],
    },
  ],
}
