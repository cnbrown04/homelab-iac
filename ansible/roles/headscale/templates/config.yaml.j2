server_url: {{ headscale_server_url | to_json }}
listen_addr: {{ headscale_listen_addr | to_json }}
metrics_listen_addr: 127.0.0.1:9090
grpc_listen_addr: 127.0.0.1:50443
grpc_allow_insecure: false
trusted_proxies: {{ headscale_trusted_proxies | to_json }}

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: false
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  paths: []
  auto_update_enabled: true
  update_frequency: 3h

disable_check_updates: false

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true
    wal_autocheckpoint: 1000

policy:
  mode: file
  path: {{ headscale_acl_path | to_json }}

dns:
  magic_dns: {{ headscale_magic_dns | bool | to_json }}
{% if headscale_magic_dns | bool %}
  base_domain: {{ headscale_base_domain | to_json }}
{% endif %}
  override_local_dns: false
  nameservers:
    global: []
  search_domains: []

log:
  level: info
  format: text

{% if headscale_oidc_issuer | length > 0 %}
oidc:
  # Headscale starts when the OIDC provider is down. Only the browser login of
  # a personal device waits for the provider.
  only_start_if_oidc_is_available: false
  issuer: {{ headscale_oidc_issuer | to_json }}
  client_id: {{ headscale_oidc_client_id | to_json }}
  client_secret_path: {{ headscale_oidc_secret_path | to_json }}
  pkce:
    enabled: true
    method: S256

{% endif %}
unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

logtail:
  enabled: false
