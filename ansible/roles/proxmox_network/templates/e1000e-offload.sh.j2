#!/bin/sh
# Ansible writes this file. See the role proxmox_network.
# The e1000e driver can stop with "Detected Hardware Unit Hang" when TCP
# segmentation offload is on. Then the NIC sends nothing until a reboot.
{% for interface in proxmox_network_e1000e_interfaces %}
[ "$IFACE" = "{{ interface }}" ] && /usr/sbin/ethtool -K "$IFACE" tso off gso off
{% endfor %}
exit 0
